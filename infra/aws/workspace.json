{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Gesso: one NVIDIA GPU host, retained encrypted workspace, HTTPS and SSM. Creates billable resources; no replicas or automatic data migration.",
  "Metadata": {
    "GessoContract": {
      "queueOwners": 1,
      "gpuRuntimeProof": "Actual Cycles frame and verified hardware WebGL2 before host creation succeeds. HTTPS/DNS and full export still require acceptance.",
      "replacement": "Never force-detach storage. Stop old host; snapshot/unmount/detach; review an explicit maintenance change."
    }
  },
  "Parameters": {
    "AmiId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Pinned x86_64 Ubuntu NVIDIA DLAMI ID resolved during read-only preflight."
    },
    "AvailabilityZone": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-z]{2}-[a-z]+-[0-9][a-z]$",
      "Description": "Preflight pins an offered AZ. Empty selects first account AZ for new disks only."
    },
    "InstanceType": {
      "Type": "String",
      "Default": "g6.2xlarge",
      "AllowedValues": [
        "g6.xlarge",
        "g6.2xlarge",
        "g5.2xlarge"
      ]
    },
    "BackendDomain": {
      "Type": "String",
      "AllowedPattern": "^(?=.{1,253}$)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$",
      "Description": "Owned DNS hostname; create an A record to ElasticIp after initial host readiness."
    },
    "PublicEditorUrl": {
      "Type": "String",
      "Default": "https://gesso-studio-gold.vercel.app",
      "AllowedPattern": "^https://[a-z0-9][a-z0-9.-]+(?::[0-9]+)?$"
    },
    "ImageUri": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9][a-z0-9._/-]*@sha256:[a-f0-9]{64}$",
      "Description": "Immutable same-account, same-region private ECR digest. Tags are not accepted."
    },
    "RepositoryName": {
      "Type": "String",
      "Default": "gesso-render",
      "AllowedPattern": "^[a-z0-9][a-z0-9._/-]*$"
    },
    "WorkspaceGiB": {
      "Type": "Number",
      "Default": 100,
      "MinValue": 20,
      "MaxValue": 4096
    },
    "RootGiB": {
      "Type": "Number",
      "Default": 80,
      "MinValue": 60,
      "MaxValue": 1024
    },
    "RootDeviceName": {
      "Type": "String",
      "Default": "/dev/sda1",
      "AllowedValues": [
        "/dev/sda1",
        "/dev/xvda"
      ]
    },
    "ExistingWorkspaceVolumeId": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^vol-[a-f0-9]{8,17}$",
      "Description": "Retained ext4 volume in the selected AZ; must be detached before host replacement. Never formatted."
    },
    "BootstrapUrl": {
      "Type": "String",
      "AllowedPattern": "^https://raw\\.githubusercontent\\.com/kimestelle/3d-product-suite/[a-f0-9]{40}/infra/aws/bootstrap\\.sh$"
    },
    "BootstrapSha256": {
      "Type": "String",
      "AllowedPattern": "^[a-f0-9]{64}$"
    }
  },
  "Conditions": {
    "CreateWorkspace": {
      "Fn::Equals": [
        {
          "Ref": "ExistingWorkspaceVolumeId"
        },
        ""
      ]
    },
    "ChooseZone": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AvailabilityZone"
            },
            ""
          ]
        }
      ]
    }
  },
  "Rules": {
    "ExistingDiskNeedsPinnedZone": {
      "RuleCondition": {
        "Fn::Not": [
          {
            "Fn::Equals": [
              {
                "Ref": "ExistingWorkspaceVolumeId"
              },
              ""
            ]
          }
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "AvailabilityZone"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "Existing workspace volumes require an explicit matching availability zone."
        }
      ]
    }
  },
  "Resources": {
    "Network": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.42.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "GessoStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "GessoStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        },
        "VpcId": {
          "Ref": "Network"
        }
      }
    },
    "PublicSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "CidrBlock": "10.42.1.0/24",
        "AvailabilityZone": {
          "Fn::If": [
            "ChooseZone",
            {
              "Ref": "AvailabilityZone"
            },
            {
              "Fn::Select": [
                0,
                {
                  "Fn::GetAZs": ""
                }
              ]
            }
          ]
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "GessoStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "Tags": [
          {
            "Key": "GessoStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "SubnetRoute": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "SubnetId": {
          "Ref": "PublicSubnet"
        }
      }
    },
    "WebSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS and ACME only. No public SSH or app port.",
        "VpcId": {
          "Ref": "Network"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          {
            "Key": "GessoStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "WorkspaceVolume": {
      "Type": "AWS::EC2::Volume",
      "Condition": "CreateWorkspace",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "AvailabilityZone": {
          "Fn::If": [
            "ChooseZone",
            {
              "Ref": "AvailabilityZone"
            },
            {
              "Fn::Select": [
                0,
                {
                  "Fn::GetAZs": ""
                }
              ]
            }
          ]
        },
        "Encrypted": true,
        "VolumeType": "gp3",
        "Size": {
          "Ref": "WorkspaceGiB"
        },
        "Tags": [
          {
            "Key": "GessoStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "WorkspaceAccessKey": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": {
          "Fn::Sub": "Gesso shared-workspace access key for ${AWS::StackName}. Keep out of browser builds."
        },
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "GessoStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "HostRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "SingleWorkspaceHost",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/${RepositoryName}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "WorkspaceAccessKey"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ec2:DescribeVolumes",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "ec2:AttachVolume",
                  "Resource": {
                    "Fn::Sub": [
                      "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:volume/${VolumeId}",
                      {
                        "VolumeId": {
                          "Fn::If": [
                            "CreateWorkspace",
                            {
                              "Ref": "WorkspaceVolume"
                            },
                            {
                              "Ref": "ExistingWorkspaceVolumeId"
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ec2:AttachVolume",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/GessoStackId": {
                        "Ref": "AWS::StackId"
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "cloudformation:SignalResource",
                  "Resource": {
                    "Ref": "AWS::StackId"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "HostProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "HostRole"
          }
        ]
      }
    },
    "RenderHost": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "PublicRoute",
        "SubnetRoute"
      ],
      "CreationPolicy": {
        "ResourceSignal": {
          "Count": 1,
          "Timeout": "PT30M"
        }
      },
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "IamInstanceProfile": {
          "Ref": "HostProfile"
        },
        "SubnetId": {
          "Ref": "PublicSubnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "WebSecurityGroup"
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1,
          "HttpEndpoint": "enabled"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": {
              "Ref": "RootDeviceName"
            },
            "Ebs": {
              "VolumeSize": {
                "Ref": "RootGiB"
              },
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "GessoStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": [
              "#!/bin/bash\nset -Eeuo pipefail\numask 077\nexec >>/var/log/gesso-cloud-init.log 2>&1\nexport AWS_DEFAULT_REGION='${AWS::Region}'\nexport GESSO_STACK_ID='${AWS::StackId}'\nexport GESSO_DOMAIN='${BackendDomain}'\nexport GESSO_PUBLIC_URL='${PublicEditorUrl}'\nexport GESSO_IMAGE_URI='${ImageUri}'\nexport GESSO_VOLUME_ID='${VolumeId}'\nexport GESSO_SECRET_ARN='${WorkspaceAccessKey}'\nexport GESSO_FORMAT_NEW_VOLUME='${FormatNewVolume}'\ntrap 'aws cloudformation signal-resource --stack-name \"$GESSO_STACK_ID\" --logical-resource-id RenderHost --unique-id bootstrap --status FAILURE || true' ERR\nmkdir -p /opt/gesso\ncurl --fail --location --retry 5 --max-time 180 '${BootstrapUrl}' --output /opt/gesso/bootstrap.sh\nprintf '${BootstrapSha256}  /opt/gesso/bootstrap.sh\\n' | sha256sum --check --status\nexec bash /opt/gesso/bootstrap.sh\n",
              {
                "VolumeId": {
                  "Fn::If": [
                    "CreateWorkspace",
                    {
                      "Ref": "WorkspaceVolume"
                    },
                    {
                      "Ref": "ExistingWorkspaceVolumeId"
                    }
                  ]
                },
                "FormatNewVolume": {
                  "Fn::If": [
                    "CreateWorkspace",
                    "true",
                    "false"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "PublicIp": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "GessoStackId",
            "Value": {
              "Ref": "AWS::StackId"
            }
          },
          {
            "Key": "Name",
            "Value": {
              "Ref": "AWS::StackName"
            }
          }
        ]
      }
    },
    "PublicIpAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "PublicIp",
            "AllocationId"
          ]
        },
        "InstanceId": {
          "Ref": "RenderHost"
        }
      }
    }
  },
  "Outputs": {
    "BackendUrl": {
      "Value": {
        "Fn::Sub": "https://${BackendDomain}"
      }
    },
    "HealthUrl": {
      "Value": {
        "Fn::Sub": "https://${BackendDomain}/api/health"
      }
    },
    "ElasticIp": {
      "Value": {
        "Ref": "PublicIp"
      }
    },
    "InstanceId": {
      "Value": {
        "Ref": "RenderHost"
      }
    },
    "WorkspaceVolumeId": {
      "Value": {
        "Fn::If": [
          "CreateWorkspace",
          {
            "Ref": "WorkspaceVolume"
          },
          {
            "Ref": "ExistingWorkspaceVolumeId"
          }
        ]
      }
    },
    "WorkspaceAccessKeyArn": {
      "Value": {
        "Ref": "WorkspaceAccessKey"
      }
    },
    "ImageUri": {
      "Value": {
        "Ref": "ImageUri"
      }
    },
    "SsmSessionCommand": {
      "Value": {
        "Fn::Sub": "aws ssm start-session --region ${AWS::Region} --target ${RenderHost}"
      }
    }
  }
}
